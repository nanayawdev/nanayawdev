# Postgres — Neon connection string (or the local Docker instance from
# docker-compose.yml if you'd rather run Postgres locally).
DATABASE_URL=

# Auth — any long random string works for local dev
JWT_SECRET=

# Transactional email (Resend) — used by contact/reply flows
RESEND_API_KEY=
RESEND_FROM="nanayawdev <hello@nanayawdev.com>"

# Object storage — used by the admin media upload endpoint.
# Local dev: point at the Docker MinIO service (see docker-compose.yml).
# Production: leave S3_ENDPOINT unset and set R2_ACCOUNT_ID instead — the
# client falls back to Cloudflare R2's endpoint.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_PUBLIC_URL=
R2_ACCOUNT_ID=

# Arkesel SMS — the active SMS provider, used by the chat widget's OTP flow,
# admin manual SMS replies, and event/USSD ticket confirmations.
# ARKESEL_SMS_BASE_URL only needs setting if it ever differs from Arkesel's
# default (https://sms.arkesel.com/sms/api).
ARKESEL_SMS_API_KEY=
ARKESEL_SMS_SENDER_ID=
ARKESEL_SMS_BASE_URL=

# Hubtel SMS — ARCHIVED for now (src/lib/_archive/hubtel.ts is unimported;
# Arkesel above is what's actually used). Left here so reviving it later
# doesn't mean hunting for these values again.
HUBTEL_SMS_BASE_URL=
HUBTEL_SMS_CLIENT_ID=
HUBTEL_SMS_CLIENT_SECRET=
HUBTEL_SMS_SENDER_ID=

# SendrPlus USSD platform (your own product, not a third party) — register
# these two URLs against your event's SendrPlus USSD application (Configure
# dialog on sendrplusweb, or POST /v1/ussd/applications/:id/configure):
#   Interaction URL:  https://<your-domain>/api/ussd/interaction
#   Fulfillment URL:  https://<your-domain>/api/ussd/fulfilment   (optional)
# Configure returns a one-time `signing_secret` (looks like whsec_<64 hex>) —
# put that here. It verifies the X-SendrPlus-Signature header (HMAC-SHA512
# over the raw request body) on every inbound call, so only your SendrPlus
# application can drive these routes. Re-running Configure rotates this
# secret, so update this value if you ever reconfigure the application.
SENDRPLUS_USSD_SIGNING_SECRET=

# Google AdSense — publisher client ID (ca-pub-XXXXXXXXXXXXXXXX). Must be
# NEXT_PUBLIC_ since ad slots read it in the browser. Leave blank locally —
# ad slots render as labeled placeholders in dev, and nothing in prod, until
# this is set. Ads only load after the cookie banner is accepted.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# AI writing tools in the admin blog editor (continue/lengthen/refine/tone).
# Set whichever provider(s) you want to use — the editor lets you switch
# between them per-request. OPENAI_MODEL defaults to gpt-4o if unset.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=

# WhatsApp Community invite link — shown as a join me modal on resource/blog
# posts once the reader scrolls partway through. Must be NEXT_PUBLIC_ since
# it's read in the browser. Leave blank locally to disable the modal.
NEXT_PUBLIC_WHATSAPP_COMMUNITY_URL=
