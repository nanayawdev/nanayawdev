# Postgres — Neon connection string (or the local Docker instance from
# docker-compose.yml if you'd rather run Postgres locally).
DATABASE_URL=

# Auth — any long random string works for local dev
JWT_SECRET=

# Transactional email (Resend) — used by contact/reply flows
RESEND_API_KEY=
RESEND_FROM="nanayawdev <hello@nanayawdev.com>"

# Object storage — used by the admin media upload endpoint.
# Local dev: point at the Docker MinIO service (see docker-compose.yml).
# Production: leave S3_ENDPOINT unset and set R2_ACCOUNT_ID instead — the
# client falls back to Cloudflare R2's endpoint.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_PUBLIC_URL=
R2_ACCOUNT_ID=

# Hubtel SMS — used by the chat widget's OTP flow
HUBTEL_SMS_BASE_URL=
HUBTEL_SMS_CLIENT_ID=
HUBTEL_SMS_CLIENT_SECRET=
HUBTEL_SMS_SENDER_ID=

# Google AdSense — publisher client ID (ca-pub-XXXXXXXXXXXXXXXX). Must be
# NEXT_PUBLIC_ since ad slots read it in the browser. Leave blank locally —
# ad slots render as labeled placeholders in dev, and nothing in prod, until
# this is set. Ads only load after the cookie banner is accepted.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
